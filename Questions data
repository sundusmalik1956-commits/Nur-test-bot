def gdrive_direct_link(share_link: str) -> str:
    """يحوّل رابط مشاركة جوجل درايف العادي إلى رابط تحميل مباشر."""
    try:
        file_id = share_link.split("/d/")[1].split("/")[0]
        return f"https://drive.google.com/uc?export=download&id={file_id}"
    except Exception:
        return share_link


